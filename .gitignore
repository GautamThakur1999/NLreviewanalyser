# ---------------------------------------------------------------------------
# SECRETS — never commit. This repository is PUBLIC.
# A pushed API key is compromised the moment it lands, even if deleted after.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/
config/secrets.yaml
config/salt.txt
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# COLLECTED DATA — never commit.
# Two reasons: (1) the corpus contains third-party user-generated content that
# we collected but do not own and must not redistribute (ARCHITECTURE.md §18);
# (2) it is large and regenerable from the pipeline by design.
# ---------------------------------------------------------------------------
data/
!data/.gitkeep
*.parquet
*.jsonl
*.jsonl.gz
*.duckdb
*.db

# Analysis outputs are reproducible artifacts, not source
outputs/
runs/
manifests/
*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
env/
venv/
.venv/
ENV/
.conda/
.python-version

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Claude Code local session state
# ---------------------------------------------------------------------------
.claude/
